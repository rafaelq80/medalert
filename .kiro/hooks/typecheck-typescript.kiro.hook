{
  "enabled": true,
  "name": "TypeScript Check on Save",
  "description": "Runs TypeScript compiler check (tsc --noEmit) on saved TypeScript/TSX files to catch type errors early.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.ts",
      "**/*.tsx"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "cd mobile && npx tsc --noEmit 2>&1 | head -30",
    "timeout": 30
  }
}